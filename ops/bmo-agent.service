# BMO voice agent, run as a systemd USER service (no root needed).
# Installed by: ops/bmo-ctl.sh install-service
#
# Starts once the desktop's display exists, restarts the agent if it exits,
# and sends its output to the journal (ops/bmo-ctl.sh logs).
[Unit]
Description=BMO voice agent
After=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=%h/be-more-agent
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
# Wait (up to 90 s) for the desktop to create the display, then let it settle.
ExecStartPre=/bin/sh -c 'i=0; while [ ! -S /tmp/.X11-unix/X0 ] && [ "$i" -lt 90 ]; do sleep 1; i=$((i+1)); done; sleep 3'
ExecStart=%h/be-more-agent/start_agent.sh
Restart=always
RestartSec=5
# Give the agent time to stop its audio pipeline cleanly.
TimeoutStopSec=15

[Install]
WantedBy=default.target
